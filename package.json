{
  "name": "musewalk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "An immersive, config-driven 3D art gallery you can walk through — drop in a folder of images and one JSON file to build your own virtual museum.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node scripts/check-config.mjs",
    "release:check": "node scripts/check-config.mjs --public && node scripts/check-privacy.mjs && node scripts/check-release-assets.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/noto-serif-sc": "5.3.0",
    "camera-controls": "^3.1.2",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "puppeteer-core": "^25.1.0",
    "vite": "^8.1.4"
  },
  "engines": {
    "node": ">=20.19"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shuyan-5200/musewalk.git"
  },
  "keywords": [
    "3d",
    "threejs",
    "webgl",
    "art-gallery",
    "museum",
    "virtual-gallery",
    "vite",
    "config-driven",
    "immersive"
  ]
}
